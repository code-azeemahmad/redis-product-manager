# ==============================================================================
# Environment Configuration Template (.env.sample)
# ==============================================================================
# Copy this file to .env and configure the variables for your deployment:
#   cp .env.sample .env
#
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=
DEBUG=
LOG_LEVEL=
APP_NAME=
APP_HOST=
APP_PORT=

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Authoritative Data Store)
# ------------------------------------------------------------------------------
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Connection Pool Settings
POSTGRES_POOL_SIZE=
POSTGRES_MAX_OVERFLOW=
POSTGRES_POOL_TIMEOUT=

# Optional explicit connection string (auto-constructed if omitted)
# DATABASE_URL=

# ------------------------------------------------------------------------------
# Redis 8 Configuration (Disposable Cache & Best-Effort Limiter)
# ------------------------------------------------------------------------------
REDIS_HOST=
REDIS_PORT=
REDIS_USER=
REDIS_PASSWORD=
HEALTHCHECK_REDIS_PASSWORD=
ADMIN_REDIS_PASSWORD=

# Connection Pool and Timeout Settings
REDIS_SOCKET_TIMEOUT=
REDIS_CONNECT_TIMEOUT=
REDIS_MAX_CONNECTIONS=

# Optional explicit connection string (auto-constructed if omitted)
# REDIS_URL=

# ------------------------------------------------------------------------------
# Caching Policy & TTL Settings (in seconds)
# ------------------------------------------------------------------------------
CACHE_KEY_PREFIX=
CACHE_PRODUCT_DETAIL_TTL=
CACHE_PRODUCT_LIST_TTL=
CACHE_DASHBOARD_STATS_TTL=

# ------------------------------------------------------------------------------
# Rate Limiting Settings
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=
RATE_LIMIT_DEFAULT_REQUESTS=
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=

# ------------------------------------------------------------------------------
# Network, Proxy & Security Settings
# ------------------------------------------------------------------------------
# Host port published by Nginx entry point
NGINX_PORT=

# Comma-separated list of trusted proxy CIDRs/IPs for X-Forwarded-For evaluation
TRUSTED_PROXY_IPS=

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=
